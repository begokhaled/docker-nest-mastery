# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting containers:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_PORT=3000
APP_NAME=docker-nest-mastery
API_PREFIX=api/v1

# ------------------------------------------------------------------------------
# POSTGRESQL DATABASE (Relational Data / TypeORM)
# ------------------------------------------------------------------------------
# Local Docker host is 'postgres' (the Docker Compose service name)
# On AWS, this would be an RDS endpoint e.g., mydb.xyz.us-east-1.rds.amazonaws.com
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=nest_docker_db
POSTGRES_SYNCHRONIZE=true
POSTGRES_LOGGING=true

# ------------------------------------------------------------------------------
# MONGODB (NoSQL / Document Store / Mongoose)
# ------------------------------------------------------------------------------
# Local Docker host is 'mongodb' (the Docker Compose service name)
# On AWS, this could be AWS DocumentDB or MongoDB Atlas cluster URI
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=nest_mongo_db
MONGO_INITDB_ROOT_USERNAME=mongo_user
MONGO_INITDB_ROOT_PASSWORD=mongo_secure_password
# Standard connection string format:
# mongodb://username:password@host:port/database?authSource=admin
MONGO_URI=mongodb://mongo_user:mongo_secure_password@mongodb:27017/nest_mongo_db?authSource=admin

# ------------------------------------------------------------------------------
# REDIS (In-Memory Cache / PubSub / ioredis)
# ------------------------------------------------------------------------------
# Local Docker host is 'redis' (the Docker Compose service name)
# On AWS, this would be an AWS ElastiCache for Redis cluster configuration endpoint
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password
REDIS_TTL=300

# ------------------------------------------------------------------------------
# NGINX REVERSE PROXY
# ------------------------------------------------------------------------------
NGINX_PORT=80
NGINX_SSL_PORT=443
CLIENT_MAX_BODY_SIZE=10M

# ------------------------------------------------------------------------------
# AWS / DEPLOYMENT METADATA (Optional / Informational)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_APP_RUNNER_SERVICE_NAME=nest-docker-api
